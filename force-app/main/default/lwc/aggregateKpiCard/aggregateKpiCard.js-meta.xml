<?xml version="1.0" encoding="UTF-8"?>
<LightningComponentBundle xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>61.0</apiVersion>
    <isExposed>true</isExposed>
    <masterLabel>Aggregate KPI Card</masterLabel>
    <description>A KPI tile that computes its own COUNT, SUM, AVG, MIN or MAX from any object, server-side.</description>
    <targets>
        <target>lightning__AppPage</target>
        <target>lightning__RecordPage</target>
        <target>lightning__HomePage</target>
    </targets>
    <targetConfigs>
        <targetConfig targets="lightning__AppPage,lightning__RecordPage,lightning__HomePage">
            <property name="label" type="String" label="Label" default="Metric" />
            <property name="objectApiName" type="String" label="Object API Name" default="Account" />
            <property name="functionName" type="String" label="Function" default="COUNT" datasource="COUNT,SUM,AVG,MIN,MAX" />
            <property name="fieldName" type="String" label="Field API Name" description="Leave blank for COUNT to count records. SUM and AVG need a numeric field." />
            <property name="format" type="String" label="Format" default="number" datasource="none,number,currency,percent" />
            <property name="iconName" type="String" label="Icon Name" default="utility:metrics" />
            <property name="variant" type="String" label="Variant" default="base" datasource="base,success,warning,error" />
        </targetConfig>
    </targetConfigs>
</LightningComponentBundle>
