<?xml version="1.0" encoding="UTF-8"?>
<PermissionSet xmlns="http://soap.sforce.com/2006/04/metadata">
    <label>LWC Toolkit Admin</label>
    <description>Access to the salesforce-lwc-production-toolkit generic Apex services and demo custom metadata/permission, for admins and developers exercising the enterpriseDatatable demo.</description>
    <hasActivationRequired>false</hasActivationRequired>
    <classAccesses>
        <apexClass>GenericQueryService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GenericAggregateService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>GenericDmlService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>PermissionService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>CustomMetadataService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>FileManagerService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <classAccesses>
        <apexClass>SavedViewService</apexClass>
        <enabled>true</enabled>
    </classAccesses>
    <customPermissions>
        <enabled>true</enabled>
        <name>Toolkit_Bulk_Edit</name>
    </customPermissions>
    <fieldPermissions>
        <field>ToolkitDemoSetting__mdt.IsEnabled__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>ToolkitDemoSetting__mdt.Description__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <field>ToolkitDemoSetting__mdt.DefaultPageSize__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ToolkitSavedView__c.ViewKey__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ToolkitSavedView__c.ObjectApiName__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ToolkitSavedView__c.Config__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <fieldPermissions>
        <editable>true</editable>
        <field>ToolkitSavedView__c.IsDefault__c</field>
        <readable>true</readable>
    </fieldPermissions>
    <objectPermissions>
        <allowCreate>true</allowCreate>
        <allowDelete>true</allowDelete>
        <allowEdit>true</allowEdit>
        <allowRead>true</allowRead>
        <modifyAllRecords>false</modifyAllRecords>
        <object>ToolkitSavedView__c</object>
        <viewAllRecords>false</viewAllRecords>
